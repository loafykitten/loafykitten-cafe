{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loafykitten-cafe",
  "compatibility_date": "2026-06-26",
  // Range-request shim for streamed audio; see worker/index.js
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // everything else is served straight from static assets
    "run_worker_first": ["/music/*"]
  },
  "workers_dev": false,
  "preview_urls": false
}
