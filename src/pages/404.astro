---
import IslandLayout from '@/layouts/IslandLayout.astro'
import bgLanding from '@/assets/images/bg-landing.jpg'
import strings from '@/data/strings.json'
import type { BgImageMetadata } from '@/types'

const background: BgImageMetadata = {
    url: bgLanding,
    artistMetadata: {
        artist: 'Pixabay',
        artistUrl: 'https://pixabay.com/illustrations/cloud-stars-ocean-reflection-5946381/',
    },
    pageBg: '#024e50',
}
---

<IslandLayout
    title={strings.notFound.title}
    description={strings.notFound.description}
    bgImageMetadata={background}
>
    <section class="not-found">
        <h1>{strings.notFound.heading}</h1>
        {strings.notFound.paragraphsHtml.map((paragraph) => <p set:html={paragraph} />)}
    </section>
</IslandLayout>

<style>
    .not-found {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        h1 {
            font-size: 3rem;
            margin-bottom: 2rem;
        }

        p {
            font-size: 1.15rem;
            margin-bottom: 0.75rem;
        }

        a {
            color: #beef;

            &:hover {
                color: #ddd;
            }
        }
    }
</style>
