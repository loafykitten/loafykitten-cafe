---
import strings from '@/data/strings.json'
import ZineFlyer from '@/features/music/designs/ZineFlyer.astro'
import { isMusicEnabled } from '@/features/music/music-enabled'
import IslandLayout from '@/layouts/IslandLayout.astro'

const copy = strings.music
const pageTitle = isMusicEnabled ? copy.title : copy.disabled.title
const pageDescription = isMusicEnabled ? copy.description : copy.disabled.description
---

<IslandLayout title={pageTitle} description={pageDescription}>
    {
        isMusicEnabled ? (
            <ZineFlyer />
        ) : (
            <section class="music-disabled">
                <h1>{copy.disabled.heading}</h1>
                {copy.disabled.paragraphsHtml.map((paragraph) => <p set:html={paragraph} />)}
            </section>
        )
    }
</IslandLayout>

<style>
    .music-disabled {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        padding: 2rem 1rem;
    }

    .music-disabled h1 {
        font-size: 3rem;
        margin: 0 0 1.25rem;
    }

    .music-disabled p {
        font-size: 1.15rem;
        margin: 0;
    }

    .music-disabled a {
        color: #beef;
    }

    .music-disabled a:hover {
        color: #ddd;
    }
</style>
