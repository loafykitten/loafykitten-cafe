---
import { activeDesign } from '@/features/music/design-config'
import DesignRenderer from '@/features/music/DesignRenderer.astro'
import { isMusicEnabled } from '@/features/music/music-enabled'
import IslandLayout from '@/layouts/IslandLayout.astro'

const pageTitle = isMusicEnabled ? 'music and stuff' : '404 not found'
const pageDescription = isMusicEnabled
    ? "loafykitten's music — hip-hop and alt emo pop, made with too many feelings."
    : 'Page not found.'
---

<IslandLayout title={pageTitle} description={pageDescription}>
    {
        isMusicEnabled ? (
            <DesignRenderer design={activeDesign} />
        ) : (
            <section class="music-disabled">
                <h1>404 not found</h1>
                <p>music is tucked away for now.</p>
                <p>you can head back to the <a href="/">homepage</a>.</p>
            </section>
        )
    }
</IslandLayout>

<style>
    .music-disabled {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        padding: 2rem 1rem;
    }

    .music-disabled h1 {
        font-size: 3rem;
        margin: 0 0 1.25rem;
    }

    .music-disabled p {
        font-size: 1.15rem;
        margin: 0;
    }

    .music-disabled a {
        color: #beef;
    }

    .music-disabled a:hover {
        color: #ddd;
    }
</style>
