---
import { musicDesigns } from '@/features/music/design-config'
import type { MusicDesignId } from '@/features/music/design-config'
import DesignRenderer from '@/features/music/DesignRenderer.astro'
import { isMusicEnabled } from '@/features/music/music-enabled'
import IslandLayout from '@/layouts/IslandLayout.astro'

export function getStaticPaths() {
    return musicDesigns.map((design) => ({ params: { design: design.id } }))
}

const design = Astro.params.design as MusicDesignId
const meta = musicDesigns.find((d) => d.id === design)!
---

<IslandLayout
    title={`music preview: ${meta.label}`}
    description="design preview for loafykitten's music page"
>
    {
        isMusicEnabled ? (
            <>
                <nav class="preview-switcher" aria-label="Design previews">
                    <span class="preview-switcher__label">designs:</span>
                    {musicDesigns.map((d) => (
                        <a
                            href={`/music/preview/${d.id}`}
                            class:list={['preview-switcher__link', { 'is-active': d.id === design }]}
                            title={d.blurb}
                        >
                            {d.label}
                        </a>
                    ))}
                </nav>
                <DesignRenderer design={design} />
            </>
        ) : (
            <section class="music-disabled">
                <h1>404 not found</h1>
                <p>music is tucked away for now.</p>
                <p>you can head back to the <a href="/">homepage</a>.</p>
            </section>
        )
    }
</IslandLayout>

<style>
    .preview-switcher {
        align-self: center;
        margin: 0.5rem auto 0;
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
        justify-content: center;
        padding: 0.3rem 0.7rem;
        border-radius: 9999px;
        background: rgba(10, 10, 14, 0.82);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(8px);
        font-size: 0.72rem;
        max-width: calc(100vw - 1rem);
        box-sizing: border-box;
    }

    .preview-switcher__label {
        color: rgba(255, 255, 255, 0.45);
        letter-spacing: 0.05em;
    }

    .preview-switcher__link {
        color: rgba(255, 255, 255, 0.75);
        text-decoration: none;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .preview-switcher__link:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }

    .preview-switcher__link.is-active {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    .preview-switcher__link:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
    }

    .music-disabled {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        padding: 2rem 1rem;
    }

    .music-disabled a {
        color: #beef;
    }
</style>
