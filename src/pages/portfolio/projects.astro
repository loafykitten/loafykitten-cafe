---
import strings from '@/data/strings.json'
import CRTLayout from '@/features/portfolio/CRTLayout.astro'

const copy = strings.projects
const fileSublabel = copy.fileSublabelTemplate.replace('{count}', String(copy.entries.length))
---

<CRTLayout
    title={copy.title}
    description={copy.description}
    prompt={copy.prompt}
    fileLabel={copy.fileLabel}
    fileSublabel={fileSublabel}
>
    <section class="section intro">
        <h2>{copy.introHeading}</h2>
        <p set:html={copy.introHtml} />
    </section>

    <section class="section projects">
        <h2>{copy.listHeading}</h2>

        <div class="project-list">
            {
                copy.entries.map((entry) => (
                    <div class="project-entry">
                        <div class="project-header">
                            <div class="project-name">{entry.name}</div>
                            <div class="project-date">{entry.date}</div>
                        </div>
                        <div class="project-tagline">{entry.tagline}</div>
                        <p class="project-desc" set:html={entry.descriptionHtml} />
                        <ul class="skill-tags">
                            {entry.tags.map((tag) => (
                                <li>{tag}</li>
                            ))}
                        </ul>
                        <a class="project-link" href={entry.href} target="_blank" rel="noopener noreferrer">
                            {copy.viewProject}
                        </a>
                    </div>
                ))
            }
        </div>
    </section>
</CRTLayout>

<style>
    .intro {
        p {
            line-height: 1.5;
            color: #ccc;
            font-size: 0.9rem;
        }
    }

    .project-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .project-entry {
        border-left: 2px solid var(--crt-border-divider);
        padding-left: 1rem;
    }

    .project-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .project-name {
        font-size: 1rem;
        font-weight: 600;
        color: #ddd;
    }

    .project-date {
        font-size: 0.75rem;
        color: var(--crt-fg-section);
    }

    .project-tagline {
        font-size: 0.85rem;
        color: var(--crt-fg-section);
        margin-bottom: 0.5rem;
    }

    .project-desc {
        font-size: 0.8rem;
        color: #888;
        line-height: 1.4;
        margin-bottom: 0.5rem;
    }

    .project-link {
        display: inline-block;
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: #7fdbff;
        text-decoration: none;
        text-shadow: 0 0 4px #7fdbff44;
        transform: translate3d(0, 0, 0);
        transition:
            text-shadow 0.3s ease,
            transform 0.3s ease,
            letter-spacing 0.3s ease;

        &:hover {
            text-shadow: 0 0 6px #7fdbff;
            transform: translateY(-2px);
            letter-spacing: 0.05em;
        }
    }

    @media (max-width: 480px) {
        .project-header {
            flex-direction: column;
            gap: 0.125rem;
        }
    }
</style>
