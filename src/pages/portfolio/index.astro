---
import aspectEmber from '@/assets/images/aspect-ember.png'
import strings from '@/data/strings.json'
import CRTLayout from '@/features/portfolio/CRTLayout.astro'
import { Image } from 'astro:assets'

const copy = strings.portfolio
---

<CRTLayout
    title={copy.title}
    description={copy.description}
    prompt={copy.prompt}
    fileLabel={copy.fileLabel}
>
    <section class="section author">
        <Image src={aspectEmber} alt={copy.headshotAlt} />
        <div class="author-info">
            <h1 class="name">{copy.name}</h1>
            <div class="author-role">
                <p>{copy.role}</p>
            </div>
        </div>
    </section>

    <section class="section biography">
        <h2>{copy.aboutHeading}</h2>
        {copy.aboutParagraphsHtml.map((paragraph) => <p set:html={paragraph} />)}
    </section>
</CRTLayout>

<style>
    .author {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 1.5rem;

        img {
            width: 100px;
            height: 100px;
            border: 2px solid #ddd1;
            transform: translate3d(0, 0, 0);
            transition: transform 0.3s ease;

            &:hover {
                transform: translateY(-2px);
            }
        }
    }

    .author-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;

        .name {
            font-size: 1.5rem;
            color: #ddd;
        }
    }

    .author-role {
        p {
            margin: 0.25rem 0 0;
            font-size: 0.95rem;
            font-weight: 300;
            color: #ddd;
        }
    }

    .biography {
        p {
            margin-bottom: 1rem;
            line-height: 1.5;
            color: #ccc;
            font-size: 0.9rem;
        }

        p:last-child {
            margin-bottom: 0;
        }

        .link-loafykitten {
            color: var(--color-loafykitten);
            text-decoration: none;
            text-shadow: 0 0 4px var(--color-loafykitten);
        }
    }
</style>
