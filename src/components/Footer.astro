---
import strings from '@/data/strings.json'
import type { BgArtistMetadata } from '@/types/bg-artist-metadata'

interface Props {
    bgArtistMetadata?: BgArtistMetadata
}

const { bgArtistMetadata } = Astro.props

const date = new Date().getFullYear()
const author = {
    name: strings.footer.authorName,
    url: strings.footer.authorUrl,
}

const { blurbs, socialLinks } = strings.footer
---

<footer>
    <p>
        &copy; {date}
        <a href={author.url} target="_blank" rel="noopener noreferrer">{author.name}</a>
        {
            bgArtistMetadata && (
                <>
                    {' '}
                    {strings.footer.backgroundBy}{' '}
                    <a href={bgArtistMetadata.artistUrl} target="_blank" rel="noopener noreferrer">
                        {bgArtistMetadata.artist}
                    </a>
                </>
            )
        }
    </p>
    <p>
        <small
            >{strings.footer.kaomoji}
            <span data-footer-blurb>{blurbs[Math.floor(Math.random() * blurbs.length)]}</span></small
        >
    </p>
    <p class="social-links">
        {
            socialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                </a>
            ))
        }
    </p>
</footer>

<script>
    // The frontmatter pick above runs once at build time, so a static page
    // would show the same blurb on every refresh — re-roll in the browser.
    import strings from '@/data/strings.json'

    const blurbEl = document.querySelector('[data-footer-blurb]')
    const blurbs = strings.footer.blurbs
    if (blurbEl && blurbs.length > 0) {
        blurbEl.textContent = blurbs[Math.floor(Math.random() * blurbs.length)] ?? ''
    }
</script>

<style>
    footer {
        background-color: var(--footer-bg, #000a);
        width: 100%;
        z-index: 10;
        padding: 0.25rem 0;
        padding-bottom: env(safe-area-inset-bottom);
        text-align: center;
        font-size: 0.9rem;
        display: flex;
        flex-direction: column;

        p {
            padding: 0.15rem 0;
            transform: translate3d(0, 0, 0);
            transition: transform 0.3s ease;

            &:hover {
                color: #fff;
                transform: translate3d(0, -1px, 0);
            }
        }

        a {
            color: #beef;
            text-decoration: none;
        }
    }

    .social-links {
        margin-top: 0.25rem;
        display: flex;
        justify-content: center;
        gap: 1rem;

        a {
            color: #7fdbff;
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;

            &:hover {
                color: #7fdbffcc;
            }
        }
    }
</style>
