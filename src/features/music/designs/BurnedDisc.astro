        letter-spacing: 0.01em;
        text-transform: uppercase;
        color: var(--tf-pink);
    }

    .sticker--bandcamp {
        background: linear-gradient(135deg, #1ea0b0 0%, #178a99 100%);
        color: #eafcff;
        transform: rotate(3deg);
        max-width: 15rem;
    }
    .sticker--youtube {
        background: linear-gradient(135deg, #d94b46 0%, #b5322d 100%);
        color: #fff3f2;
        transform: rotate(-2.5deg);
        max-width: 13rem;
    }
    .sticker__title {
        font-family: 'Permanent Marker', cursive;
        font-size: 1.05rem;
        line-height: 1.05;
    }
    .sticker__sub {
        font-family: 'Caveat', cursive;
        font-weight: 700;
        font-size: 0.9rem;
        margin-top: 0.15rem;
        opacity: 0.95;
    }

    /* ════════════════════════════════════════════════════════════════
       RESPONSIVE — stack disc over insert
       ════════════════════════════════════════════════════════════════ */
    @media (max-width: 760px) {
        .layout {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .disc-column {
            position: static;
        }
        .stickers {
            justify-content: center;
        }
    }
    @media (max-width: 400px) {
        .track {
            grid-template-columns: 1.9rem 0.9rem 1fr auto;
            gap: 0.35rem;
        }
        .track__title {
            font-size: 1.25rem;
        }
    }

    /* ════════════════════════════════════════════════════════════════
       REDUCED MOTION
       ════════════════════════════════════════════════════════════════ */
    @media (prefers-reduced-motion: reduce) {
        .disc.is-spinning .disc__sheen,
        .disc.is-spinning .disc__dye,
        .disc.is-spinning .disc__grooves,
        .disc.is-spinning .disc__sharpie {
            animation: none;
        }
        .disc,
        .deck-btn,
        .sticker,
        .track,
        .track__scribble,
        .track__mark,
        .home-scrawl {
            transition: none;
        }
    }
</style>

<script>
    import { MusicPlayer } from '@/features/music/audio-controller'
    import { tracks } from '@/features/music/singy-songy-data'

    const fmt = (s: number) => {
        if (!isFinite(s) || s < 0) s = 0
        const m = Math.floor(s / 60)
        const sec = Math.floor(s % 60)
        return `${m}:${sec.toString().padStart(2, '0')}`
    }

    const $ = <T extends Element>(sel: string) => document.querySelector<T>(sel)

    const disc = $<HTMLButtonElement>('#disc')
    const playBtn = $<HTMLButtonElement>('#play')
    const playGlyph = $<HTMLSpanElement>('#play-glyph')
    const prevBtn = $<HTMLButtonElement>('#prev')
    const nextBtn = $<HTMLButtonElement>('#next')
    const nowTitle = $<HTMLSpanElement>('#now-title')
    const curTime = $<HTMLSpanElement>('#cur-time')
    const durTime = $<HTMLSpanElement>('#dur-time')
    const scrubber = $<HTMLButtonElement>('#scrubber')
    const scrubFill = $<HTMLSpanElement>('#scrub-fill')
    const scrubThumb = $<HTMLSpanElement>('#scrub-thumb')
    const trackButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.track'),
    )

    // if the essentials are missing, bail without throwing
    if (disc && playBtn && playGlyph && scrubber && scrubFill && scrubThumb) {
        const player = new MusicPlayer(tracks)

        const PLAY = '▶' // ▶
        const PAUSE = '⏸' // ⏸

        const setSpinning = (on: boolean) => {
            disc.classList.toggle('is-spinning', on)
        }
        const setPlayGlyph = (playing: boolean) => {
            playGlyph.textContent = playing ? PAUSE : PLAY
        }
        const markCurrent = (index: number | null) => {
            trackButtons.forEach((btn) => {
                const i = Number(btn.dataset.index)
                btn.classList.toggle('is-current', i === index)
                if (i === index) {
                    btn.setAttribute('aria-current', 'true')
                } else {
                    btn.removeAttribute('aria-current')
                }
            })
        }

        // ── events ──────────────────────────────────────────────
        player.on('change', (t) => {
            markCurrent(t.index)
            if (nowTitle) nowTitle.textContent = t.title
            if (durTime) durTime.textContent = fmt(t.duration)
            if (curTime) curTime.textContent = '0:00'
            scrubFill.style.width = '0%'
            scrubThumb.style.left = '0%'
        })

        player.on('play', () => {
            setSpinning(true)
            setPlayGlyph(true)
        })

        player.on('pause', () => {
            setSpinning(false)
            setPlayGlyph(false)
        })

        player.on('stop', () => {
            setSpinning(false)
            setPlayGlyph(false)
            if (curTime) curTime.textContent = '0:00'
            scrubFill.style.width = '0%'
            scrubThumb.style.left = '0%'
        })

        player.on('time', (current, duration, progress) => {
            if (curTime) curTime.textContent = fmt(current)
            if (durTime && isFinite(duration) && duration > 0) {
                durTime.textContent = fmt(duration)
            }
            const pct = `${Math.min(Math.max(progress, 0), 1) * 100}%`
            scrubFill.style.width = pct
            scrubThumb.style.left = pct
        })

        player.on('error', (t) => {
            setSpinning(false)
            setPlayGlyph(false)
            if (nowTitle) nowTitle.textContent = `couldn’t load “${t.title}” :(`
        })

        // ── controls ────────────────────────────────────────────
        disc.addEventListener('click', () => {
            if (!player.current) {
                player.play(0)
            } else {
                player.toggle()
            }
        })

        playBtn.addEventListener('click', () => {
            if (!player.current) {
                player.play(0)
            } else {
                player.toggle()
            }
        })

        prevBtn?.addEventListener('click', () => player.prev())
        nextBtn?.addEventListener('click', () => player.next())

        trackButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
                const i = Number(btn.dataset.index)
                if (Number.isNaN(i)) return
                player.toggle(i)
            })
        })

        // ── scrubbing (click / drag) ────────────────────────────
        const seekFromEvent = (clientX: number) => {
            const rect = scrubber.getBoundingClientRect()
            if (rect.width <= 0) return
            const frac = (clientX - rect.left) / rect.width
            player.seek(Math.min(Math.max(frac, 0), 1))
        }

        let dragging = false
        scrubber.addEventListener('pointerdown', (e) => {
            dragging = true
            scrubber.setPointerCapture(e.pointerId)
            seekFromEvent(e.clientX)
        })
        scrubber.addEventListener('pointermove', (e) => {
            if (dragging) seekFromEvent(e.clientX)
        })
        scrubber.addEventListener('pointerup', (e) => {
            dragging = false
            scrubber.releasePointerCapture(e.pointerId)
        })
        // keyboard seek: arrows nudge ±5%
        scrubber.addEventListener('keydown', (e) => {
            if (!player.current) return
            if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
                e.preventDefault()
                const currentPct = parseFloat(scrubFill.style.width) || 0
                const delta = e.key === 'ArrowRight' ? 5 : -5
                player.seek(Math.min(Math.max((currentPct + delta) / 100, 0), 1))
            }
        })
    }
</script>
