        padding: 0.5rem 0.7rem;
    }
    .sticker--advisory__top {
        font-weight: 900;
        font-size: 0.7rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }
    .sticker--advisory__bottom {
        font-weight: 900;
