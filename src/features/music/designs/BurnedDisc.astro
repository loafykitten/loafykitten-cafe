---
import { tracks, musicLinks, formatDuration } from '@/features/music/singy-songy-data'

// ────────────────────────────────────────────────────────────────────────────
// EDITABLE COPY — everything a human reads lives here. change freely.
// ────────────────────────────────────────────────────────────────────────────
const COPY = {
    discLabelTop: '4 u',
    discLabelSub: 'songs by loafykitten',
    discVol: 'vol. ∞',
    discBurnJoke: 'burned at 4x because feelings can’t be rushed',
    discHint: '(click the disc to play / pause)',

    insertHeading: 'a mixtape,',
    insertSubheading: 'hip-hop & alt-emo pop, in order →',
    insertNote: 'if u only listen to one, i get it.\nthank u for listening at all. 🐾',

    advisorySticker: ['parental advisory', 'explicit feelings'],

    bandcampStickerTitle: 'the real files live here',
    bandcampStickerSub: 'free downloads — no cd burner needed',

    youtubeStickerTitle: 'watch on youtube',
    youtubeStickerSub: '@loafykitten',

    homeLink: '← back home',

    // playback deck (masking-tape strip)
    prevLabel: 'previous track',
    playLabel: 'play / pause',
    nextLabel: 'next track',
    deckIdle: 'nothing spinning yet',
}
---

<link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Caveat:wght@500;700&display=swap"
/>

<section class="disc-page">
    <!-- full-bleed dark desk surface, behind everything -->
    <div class="desk-surface" aria-hidden="true"></div>

    <div class="layout">
        <!-- ── LEFT: the burned CD-R ─────────────────────────────────── -->
        <div class="disc-column">
            <div class="disc-stack">
                <button
                    type="button"
                    class="disc"
                    id="disc"
                    aria-label={`${COPY.playLabel} — the disc`}
                >
                    <span class="disc__sheen" aria-hidden="true"></span>
                    <span class="disc__dye" aria-hidden="true"></span>
                    <span class="disc__grooves" aria-hidden="true"></span>
                    <span class="disc__sharpie" aria-hidden="true">
                        <span class="sharpie__upper">
                            <span class="sharpie__top">{COPY.discLabelTop}</span>
                            <span class="sharpie__ears">
                                <svg viewBox="0 0 120 60" class="ears-svg" aria-hidden="true">
                                    <path
                                        d="M14 52 C16 30 24 16 36 8 C34 22 40 36 52 46 Z
                                           M106 52 C104 30 96 16 84 8 C86 22 80 36 68 46 Z"
                                        fill="none"
                                        stroke="#161616"
                                        stroke-width="3.4"
                                        stroke-linejoin="round"
                                        stroke-linecap="round"
                                    />
                                </svg>
                            </span>
                        </span>
                        <span class="sharpie__lower">
                            <span class="sharpie__sub">{COPY.discLabelSub}</span>
                            <span class="sharpie__vol">{COPY.discVol}</span>
                        </span>
                    </span>
                    <span class="disc__hub" aria-hidden="true"></span>
                    <span class="disc__hole" aria-hidden="true"></span>
                </button>

                <p class="disc-burn-joke">{COPY.discBurnJoke}</p>
                <p class="disc-hint">{COPY.discHint}</p>
            </div>

            <!-- ── PLAYBACK DECK — masking-tape strip ─────────────────── -->
            <div class="deck" role="group" aria-label="playback controls">
                <div class="deck__tape">
                    <div class="deck__buttons">
                        <button type="button" class="deck-btn" id="prev" aria-label={COPY.prevLabel}>
                            &#9198;
                        </button>
                        <button type="button" class="deck-btn deck-btn--play" id="play" aria-label={COPY.playLabel}>
                            <span id="play-glyph">&#9654;</span>
                        </button>
                        <button type="button" class="deck-btn" id="next" aria-label={COPY.nextLabel}>
                            &#9197;
                        </button>
                    </div>

                    <div class="deck__now">
                        <span class="deck__now-label" id="now-title">{COPY.deckIdle}</span>
                    </div>

                    <div class="deck__scrub">
                        <span class="deck__time" id="cur-time">0:00</span>
                        <button
                            type="button"
                            class="scrubber"
                            id="scrubber"
                            aria-label="seek within track"
                        >
                            <span class="scrubber__track" aria-hidden="true"></span>
                            <span class="scrubber__fill" id="scrub-fill" aria-hidden="true"></span>
                            <span class="scrubber__thumb" id="scrub-thumb" aria-hidden="true"></span>
                        </button>
                        <span class="deck__time" id="dur-time">0:00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── RIGHT: the paper insert ───────────────────────────────── -->
        <div class="insert-column">
            <article class="insert">
                <div class="insert__hole" aria-hidden="true"></div>

                <header class="insert__head">
                    <h1 class="insert__title">{COPY.insertHeading}</h1>
                    <p class="insert__subtitle">{COPY.insertSubheading}</p>
                </header>

                <ol class="tracklist" id="tracklist">
                    {
                        tracks.map((t) => (
                            <li>
                                <button
                                    type="button"
                                    class="track"
                                    data-index={t.index}
                                    aria-label={`play ${t.title}`}
                                >
                                    <span class="track__num">
                                        {String(t.index + 1).padStart(2, '0')}
                                    </span>
                                    <span class="track__mark" aria-hidden="true">
                                        &#9654;
                                    </span>
                                    <span class="track__title">
                                        {t.title}
                                        <span class="track__scribble" aria-hidden="true"></span>
                                    </span>
                                    <span class="track__dur">{formatDuration(t.duration)}</span>
                                </button>
                            </li>
                        ))
                    }
                </ol>

                <p class="insert__note">{COPY.insertNote}</p>

                <a class="home-scrawl" href="/">{COPY.homeLink}</a>
            </article>

            <!-- ── STICKERS ──────────────────────────────────────────── -->
            <div class="stickers" aria-hidden="false">
                <div class="sticker sticker--advisory">
                    <span class="sticker--advisory__top">{COPY.advisorySticker[0]}</span>
                    <span class="sticker--advisory__bottom">{COPY.advisorySticker[1]}</span>
                </div>

                <a
                    class="sticker sticker--bandcamp"
                    href={musicLinks.bandcamp}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="sticker__title">{COPY.bandcampStickerTitle}</span>
                    <span class="sticker__sub">{COPY.bandcampStickerSub}</span>
                </a>

                <a
                    class="sticker sticker--youtube"
                    href={musicLinks.youtube}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="sticker__title">{COPY.youtubeStickerTitle}</span>
                    <span class="sticker__sub">{COPY.youtubeStickerSub}</span>
                </a>
            </div>
        </div>
    </div>
</section>

<style is:global>
    body {
        background: #14100e;
        --footer-bg: #0c0908ee;
    }
</style>

<style>
    /* ── page frame ─────────────────────────────────────────────────── */
    .disc-page {
        --tf-blue: #5bcefa;
        --tf-pink: #f5a9b8;
        --cream: #f4ecd8;
        --ink: #1c1a17;
        --marker: #171412;
        position: relative;
        min-height: 100%;
        padding: clamp(1.25rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 3rem;
        color: var(--cream);
        text-shadow: none;
    }

    /* deep warm charcoal desk with subtle CSS grain + soft pool of light */
    .desk-surface {
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
            radial-gradient(
                120% 90% at 38% 30%,
                #2a221d 0%,
                #1d1815 45%,
                #14100e 100%
            );
    }
    .desk-surface::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            repeating-linear-gradient(
                92deg,
                rgba(255, 255, 255, 0.015) 0px,
                rgba(255, 255, 255, 0.015) 1px,
                transparent 1px,
                transparent 3px
            ),
            repeating-linear-gradient(
                2deg,
                rgba(0, 0, 0, 0.06) 0px,
                rgba(0, 0, 0, 0.06) 2px,
                transparent 2px,
                transparent 5px
            );
        opacity: 0.7;
        mix-blend-mode: overlay;
    }

    .layout {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: start;
    }

    /* ════════════════════════════════════════════════════════════════
       THE DISC
       ════════════════════════════════════════════════════════════════ */
    .disc-column {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        position: sticky;
        top: 1.5rem;
    }

    .disc-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
    }

    .disc {
        position: relative;
        width: min(72vw, 340px);
        aspect-ratio: 1 / 1;
        border-radius: 50%;
        border: none;
        padding: 0;
        cursor: pointer;
        background: #0b0b0d;
        /* the disc edge + drop shadow onto the desk */
        box-shadow:
            0 0 0 2px rgba(255, 255, 255, 0.06),
            0 22px 45px -12px rgba(0, 0, 0, 0.85),
            0 4px 10px rgba(0, 0, 0, 0.6);
        isolation: isolate;
        transition: transform 0.25s ease;
    }
    .disc:active {
        transform: scale(0.985);
    }

    /* iridescent data sheen — low-saturation rainbow conic + reflective sweep */
    .disc__sheen {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background:
            conic-gradient(
                from 210deg,
                hsl(200 45% 55% / 0.55),
                hsl(280 40% 58% / 0.5),
                hsl(340 45% 60% / 0.55),
                hsl(45 55% 62% / 0.55),
                hsl(150 40% 55% / 0.5),
                hsl(200 45% 55% / 0.55)
            );
        opacity: 0.9;
    }
    /* the writable dye ring — the greenish/teal band burners leave */
    .disc__dye {
        position: absolute;
        inset: 8%;
        border-radius: 50%;
        background:
            radial-gradient(
                circle,
                transparent 30%,
                hsla(155, 45%, 40%, 0.35) 33%,
                hsla(165, 40%, 35%, 0.28) 55%,
                hsla(180, 35%, 45%, 0.2) 74%,
                transparent 78%
            );
        mix-blend-mode: screen;
    }
    /* fine data grooves + a moving specular glint sweep */
    .disc__grooves {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background:
            repeating-radial-gradient(
                circle at 50% 50%,
                rgba(0, 0, 0, 0.16) 0px,
                rgba(0, 0, 0, 0.16) 1px,
                rgba(255, 255, 255, 0.05) 2px,
                rgba(255, 255, 255, 0.05) 3px
            ),
            conic-gradient(
                from 0deg,
                rgba(255, 255, 255, 0) 0deg,
                rgba(255, 255, 255, 0.28) 25deg,
                rgba(255, 255, 255, 0) 70deg,
                rgba(255, 255, 255, 0) 200deg,
                rgba(255, 255, 255, 0.18) 250deg,
                rgba(255, 255, 255, 0) 300deg
            );
        mix-blend-mode: overlay;
    }
    /* darken the very outer rim so the disc reads round, not flat */
    .disc::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 50%;
        background: radial-gradient(
            circle,
            transparent 78%,
            rgba(0, 0, 0, 0.35) 88%,
            rgba(0, 0, 0, 0.7) 100%
        );
        z-index: 4;
        pointer-events: none;
    }

    /* the sharpie label side (a semi-transparent painted top so the sheen
       glows through, like a real labelled CD-R) */
    .disc__sharpie {
        position: absolute;
        inset: 5%;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        /* upper/lower groups sit above and below the centre hub */
        justify-content: space-between;
        padding: 7% 6% 11%;
        box-sizing: border-box;
        background: radial-gradient(
            circle,
            rgba(238, 232, 220, 0.9) 0%,
            rgba(232, 224, 208, 0.86) 55%,
            rgba(220, 210, 190, 0.55) 74%,
            transparent 80%
        );
        color: var(--marker);
        text-align: center;
        z-index: 3;
    }
    .sharpie__upper,
    .sharpie__lower {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }
    .sharpie__ears {
        width: 24%;
        margin-top: -0.15rem;
    }
    .ears-svg {
        width: 100%;
        height: auto;
        display: block;
    }
    .sharpie__top {
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(1.2rem, 5vw, 1.6rem);
        line-height: 1;
        transform: rotate(-4deg);
    }
    .sharpie__sub {
        font-family: 'Caveat', cursive;
        font-weight: 700;
        font-size: clamp(0.95rem, 3.5vw, 1.2rem);
        transform: rotate(-1.5deg);
        color: #2c2622;
    }
    .sharpie__vol {
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(0.7rem, 2.6vw, 0.9rem);
        margin-top: 0.35rem;
        transform: rotate(3deg);
        color: #453b33;
    }

    /* clear plastic hub ring + centre hole */
    .disc__hub {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 27%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background:
            radial-gradient(
                circle,
                rgba(20, 18, 16, 0.15) 62%,
                rgba(255, 255, 255, 0.28) 64%,
                rgba(120, 120, 130, 0.4) 70%,
                rgba(200, 200, 210, 0.25) 76%,
                transparent 80%
            );
        box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.18);
        z-index: 4;
        pointer-events: none;
    }
    .disc__hole {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 12%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: #14100e;
        box-shadow:
            inset 0 2px 5px rgba(0, 0, 0, 0.9),
            0 0 0 2px rgba(255, 255, 255, 0.1);
        z-index: 5;
        pointer-events: none;
    }

    /* spinning group: everything that should rotate with the disc */
    .disc__sheen,
    .disc__dye,
    .disc__grooves,
    .disc__sharpie {
        animation: disc-spin 8s linear infinite;
        animation-play-state: paused;
    }
    .disc.is-spinning .disc__sheen,
    .disc.is-spinning .disc__dye,
    .disc.is-spinning .disc__grooves,
    .disc.is-spinning .disc__sharpie {
        animation-play-state: running;
    }
    @keyframes disc-spin {
        to {
            transform: rotate(360deg);
        }
    }
    /* keep sharpie text upright-ish while the whole thing spins slower feel:
       actually let it spin — a real labelled disc's text rotates too. */

    .disc:focus-visible {
        outline: 3px dashed var(--tf-blue);
        outline-offset: 6px;
    }

    .disc-burn-joke {
        font-family: 'Caveat', cursive;
        font-weight: 700;
        font-size: clamp(0.95rem, 3vw, 1.15rem);
        color: var(--tf-pink);
        text-align: center;
        margin: 0;
        transform: rotate(-1.5deg);
        text-shadow: none;
    }
    .disc-hint {
        font-family: 'Caveat', cursive;
        font-size: 0.95rem;
        color: #9a8f82;
        margin: 0;
        text-shadow: none;
    }

    /* ════════════════════════════════════════════════════════════════
       PLAYBACK DECK — masking tape
       ════════════════════════════════════════════════════════════════ */
    .deck {
        width: 100%;
        max-width: 360px;
    }
    .deck__tape {
        background:
            linear-gradient(
                102deg,
                #d8c9a4 0%,
                #e6d9b8 20%,
                #ddcfac 55%,
                #e2d5b2 100%
            );
        color: #2a241b;
        padding: 0.7rem 0.85rem 0.85rem;
        border-radius: 2px;
        transform: rotate(-1deg);
        box-shadow: 0 8px 18px -8px rgba(0, 0, 0, 0.7);
        /* torn/frayed tape ends */
        clip-path: polygon(
            0% 8%, 3% 0%, 12% 6%, 30% 1%, 55% 7%, 78% 1%, 96% 5%, 100% 0%,
            100% 92%, 97% 100%, 80% 94%, 55% 99%, 32% 93%, 12% 100%, 2% 95%, 0% 100%
        );
        position: relative;
    }
    .deck__tape::after {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.03) 0px,
            rgba(0, 0, 0, 0.03) 1px,
            transparent 1px,
            transparent 4px
        );
        pointer-events: none;
    }
    .deck__buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
    }
    .deck-btn {
        font-family: 'Fira Code', monospace;
        font-size: 1rem;
        line-height: 1;
        color: #2a241b;
        background: transparent;
        border: 2px solid #3a3226;
        border-radius: 50%;
        width: 2.3rem;
        height: 2.3rem;
        display: grid;
        place-items: center;
        cursor: pointer;
        text-shadow: none;
        transition: transform 0.12s ease, background 0.12s ease;
    }
    .deck-btn:hover {
        background: rgba(0, 0, 0, 0.08);
    }
    .deck-btn:active {
        transform: scale(0.9);
    }
    .deck-btn--play {
        width: 2.9rem;
        height: 2.9rem;
        font-size: 1.15rem;
        border-width: 3px;
        background: rgba(245, 169, 184, 0.35);
    }
    .deck-btn:focus-visible {
        outline: 3px solid #5b8cfa;
        outline-offset: 2px;
    }

    .deck__now {
        text-align: center;
        margin: 0.5rem 0 0.35rem;
        min-height: 1.2rem;
    }
    .deck__now-label {
        font-family: 'Permanent Marker', cursive;
        font-size: 0.95rem;
        color: #2a241b;
    }

    .deck__scrub {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .deck__time {
        font-family: 'Fira Code', monospace;
        font-size: 0.72rem;
        color: #3a3226;
        min-width: 2.6ch;
        text-align: center;
    }
    .scrubber {
        position: relative;
        flex: 1;
        height: 1.4rem;
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
    }
    .scrubber__track {
        position: absolute;
        left: 0;
        right: 0;
        height: 3px;
        background: rgba(0, 0, 0, 0.25);
        border-radius: 2px;
    }
    .scrubber__fill {
        position: absolute;
        left: 0;
        height: 3px;
        width: 0%;
        background: #2a241b;
        border-radius: 2px;
    }
    .scrubber__thumb {
        position: absolute;
        left: 0%;
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
        background: #2a241b;
        transform: translateX(-50%);
        box-shadow: 0 0 0 3px rgba(245, 169, 184, 0.5);
    }
    .scrubber:focus-visible {
        outline: 3px solid #5b8cfa;
        outline-offset: 3px;
        border-radius: 3px;
    }

    /* ════════════════════════════════════════════════════════════════
       THE INSERT — cream paper card
       ════════════════════════════════════════════════════════════════ */
    .insert-column {
        position: relative;
    }
    .insert {
        position: relative;
        background:
            linear-gradient(
                175deg,
                #f6efdd 0%,
                #f0e7cf 100%
            );
        color: var(--ink);
        text-shadow: none;
        padding: clamp(1.4rem, 3vw, 2.2rem) clamp(1.3rem, 3vw, 2rem);
        transform: rotate(1deg);
        box-shadow:
            0 20px 40px -16px rgba(0, 0, 0, 0.8),
            0 2px 6px rgba(0, 0, 0, 0.3);
        /* torn / hand-cut paper edges */
        clip-path: polygon(
            0% 2%, 4% 0.5%, 14% 2%, 28% 0%, 46% 1.6%, 62% 0.3%, 80% 1.8%, 94% 0.4%, 100% 2%,
            99% 20%, 100% 44%, 98.6% 66%, 100% 84%, 99% 98%,
            88% 99.5%, 70% 98%, 52% 99.8%, 34% 98.4%, 16% 99.6%, 4% 98.4%, 0% 98%,
            1.2% 74%, 0% 52%, 1.4% 30%, 0% 12%
        );
    }
    /* faint ruled-paper lines */
    .insert::before {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            transparent 0,
            transparent 1.85rem,
            rgba(90, 120, 180, 0.13) 1.85rem,
            rgba(90, 120, 180, 0.13) calc(1.85rem + 1px)
        );
        pointer-events: none;
        opacity: 0.6;
    }
    /* punched insert hole in the corner */
    .insert__hole {
        position: absolute;
        top: 1.1rem;
        right: 1.3rem;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 50%;
        background: #14100e;
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.8);
    }

    .insert__head {
        position: relative;
        margin-bottom: 0.9rem;
    }
    .insert__title {
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(1.7rem, 6vw, 2.4rem);
        color: var(--ink);
        margin: 0;
        transform: rotate(-1.5deg);
        text-shadow: none;
    }
    .insert__subtitle {
        font-family: 'Caveat', cursive;
        font-weight: 700;
        font-size: clamp(1rem, 3.5vw, 1.25rem);
        color: #6a5b3d;
        margin: 0.1rem 0 0;
        text-shadow: none;
    }
    /* neutralise the global h/p hover inside the paper */
    .insert h1:hover,
    .insert p:hover {
        color: inherit;
        transform: none;
    }
    .insert__title:hover {
        transform: rotate(-1.5deg);
    }

    .tracklist {
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: none;
        position: relative;
        z-index: 1;
    }
    .tracklist li {
        margin: 0;
    }
    .track {
        width: 100%;
        display: grid;
        grid-template-columns: 2.2rem 1.1rem 1fr auto;
        align-items: baseline;
        gap: 0.5rem;
        background: transparent;
        border: none;
        border-bottom: 1px dashed rgba(60, 50, 30, 0.25);
        padding: 0.55rem 0.35rem;
        cursor: pointer;
        text-align: left;
        color: var(--ink);
        text-shadow: none;
        font-family: 'Caveat', cursive;
        transition: background 0.12s ease;
    }
    .track:hover {
        background: rgba(245, 169, 184, 0.18);
    }
    .track__num {
        font-family: 'Permanent Marker', cursive;
        font-size: 1rem;
        color: #8a7346;
    }
    .track__mark {
        font-size: 0.7rem;
        color: var(--ink);
        opacity: 0;
        transform: translateX(-3px);
        transition: opacity 0.12s ease, transform 0.12s ease;
    }
    .track:hover .track__mark {
        opacity: 0.7;
        transform: translateX(0);
    }
    .track__title {
        position: relative;
        font-weight: 700;
        font-size: 1.4rem;
        line-height: 1.1;
        color: var(--ink);
    }
    /* marker scribble under the currently-playing title */
    .track__scribble {
        position: absolute;
        left: -2%;
        right: -2%;
        bottom: -0.1rem;
        height: 0.55rem;
        opacity: 0;
        background:
            radial-gradient(
                ellipse 50% 60% at 50% 50%,
                rgba(245, 169, 184, 0.7) 0%,
                rgba(245, 169, 184, 0.55) 60%,
                transparent 72%
            );
        transform: rotate(-1.2deg) scaleX(0.6);
        transform-origin: left center;
        transition: opacity 0.2s ease, transform 0.3s ease;
        z-index: -1;
    }
    .track.is-current .track__scribble {
        opacity: 1;
        transform: rotate(-1.2deg) scaleX(1);
    }
    .track.is-current .track__title {
        color: #1a1512;
    }
    .track.is-current .track__num {
        color: #c85a72;
    }
    .track.is-current .track__mark {
        opacity: 1;
        transform: translateX(0);
        color: #c85a72;
    }
    .track__dur {
        font-family: 'Fira Code', monospace;
        font-size: 0.78rem;
        color: #6a5b3d;
    }
    .track:focus-visible {
        outline: 2px solid #5b8cfa;
        outline-offset: -2px;
        border-radius: 4px;
    }

    .insert__note {
        font-family: 'Caveat', cursive;
        font-weight: 500;
        font-size: 1.2rem;
        line-height: 1.35;
        color: #4a3d28;
        margin: 1.1rem 0 0.4rem;
        white-space: pre-line;
        transform: rotate(-0.6deg);
        text-shadow: none;
        position: relative;
        z-index: 1;
    }

    .home-scrawl {
        display: inline-block;
        font-family: 'Permanent Marker', cursive;
        font-size: 1.05rem;
        color: #4a6ab0;
        text-decoration: none;
        margin-top: 0.4rem;
        transform: rotate(-2deg);
        text-shadow: none;
        position: relative;
        z-index: 1;
    }
    .home-scrawl:hover {
        color: #35509a;
        transform: rotate(-2deg) translateX(-3px);
    }
    .home-scrawl:focus-visible {
        outline: 2px solid #5b8cfa;
        outline-offset: 3px;
        border-radius: 3px;
    }

    /* ════════════════════════════════════════════════════════════════
       STICKERS
       ════════════════════════════════════════════════════════════════ */
    .stickers {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 1.4rem;
