        text-shadow: none;
        padding: 0.6rem 0.85rem;
        box-shadow: 0 6px 14px -6px rgba(0, 0, 0, 0.7);
        transition: transform 0.15s ease;
    }
    .sticker:hover {
        transform: scale(1.04) rotate(0deg) !important;
    }
    .sticker:focus-visible {
        outline: 3px solid var(--tf-blue);
        outline-offset: 3px;
    }

    /* parental-advisory parody */
    .sticker--advisory {
        background: #101010;
        color: #fff;
        border: 3px solid #fff;
