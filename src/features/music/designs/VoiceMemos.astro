---
import { tracks, musicLinks, formatDuration } from '@/features/music/singy-songy-data'

// ─────────────────────────────────────────────────────────────
// COPY — everything human-visible lives here so it's easy to edit.
// keep the track notes meaning-neutral; they're vibe, not lyrics.
// ─────────────────────────────────────────────────────────────
const copy = {
    back: '‹ back',
    appTitle: 'songs i actually finished',
    appSubtitle: '8 recordings · all feelings',
    pinnedTitle: 'the full songs live on bandcamp',
    pinnedBody: 'free. take them. no email, no catch — i just want you to have them.',
    bandcampCta: 'download the album (free)',
    youtubeCta: 'or watch stuff on youtube',
    footNote: 'recorded late, uploaded nervous. thank you for listening this far <3',
    playerEmptyTitle: 'nothing playing yet',
    playerEmptyNote: 'tap a memo to start',
    nowPlaying: 'now playing',
    errorNote: "couldn't load this one, sorry",
    // one quiet sub-label per track, in listening order.
    notes: [
        'one take, sorry',
        'recorded instead of sleeping',
        '3:12 am',
        'phone mic, obviously',
        'kept the little mistakes',
        'sang this one too quiet',
        'hands were kind of shaking',
        'the trailing comma is on purpose',
    ] as string[],
}

// deterministic little waveform per row so each looks its own way
const waveBars = (seed: number, count = 34): number[] => {
    const out: number[] = []
    let x = (seed + 1) * 12345 + 6789
    for (let i = 0; i < count; i++) {
        x = (x * 1103515245 + 12345) & 0x7fffffff
        const r = x / 0x7fffffff
        out.push(Math.round(24 + r * 72)) // 24–96
    }
    return out
}
---

<section class="vm">
    <div class="vm-glow" aria-hidden="true"></div>

    <div class="vm-app">
        <header class="vm-head">
            <a class="vm-back" href="/">{copy.back}</a>
            <div class="vm-titlewrap">
                <span class="vm-recdot" aria-hidden="true"></span>
                <h1 class="vm-title">{copy.appTitle}</h1>
            </div>
            <p class="vm-sub">{copy.appSubtitle}</p>
        </header>

        <div class="vm-pinned">
            <span class="vm-pin-tag">pinned</span>
            <h2 class="vm-pin-title">{copy.pinnedTitle}</h2>
            <p class="vm-pin-body">{copy.pinnedBody}</p>
            <div class="vm-pin-links">
                <a
                    class="vm-link vm-link-primary"
                    href={musicLinks.bandcamp}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="vm-link-icon" aria-hidden="true">↓</span>
                    {copy.bandcampCta}
                </a>
                <a
                    class="vm-link vm-link-ghost"
                    href={musicLinks.youtube}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {copy.youtubeCta}
                </a>
            </div>
        </div>

        <ol class="vm-list">
            {
                tracks.map((t) => (
                    <li class="vm-item">
                        <button
                            class="row"
                            type="button"
                            data-track={t.index}
                            aria-pressed="false"
                            aria-label={`play ${t.title}`}
                        >
                            <span class="row-lead" aria-hidden="true">
                                <span class="idx-num">
                                    {String(t.index + 1).padStart(2, '0')}
                                </span>
                                <span class="idx-play">
                                    <svg class="ic ic-play" viewBox="0 0 24 24">
                                        <path d="M8 5v14l11-7z" />
                                    </svg>
                                    <svg class="ic ic-pause" viewBox="0 0 24 24">
                                        <path d="M7 5h3v14H7zM14 5h3v14h-3z" />
                                    </svg>
                                </span>
                            </span>

                            <span class="row-main">
                                <span class="row-toprow">
                                    <span class="row-title">{t.title}</span>
                                    <span class="row-live" aria-hidden="true">
                                        <span class="live-dot" />
                                        {copy.nowPlaying}
                                    </span>
                                </span>
                                <span class="row-note" data-note={t.index}>
                                    {copy.notes[t.index]}
                                </span>
                                <span class="wave" aria-hidden="true">
                                    {waveBars(t.index).map((h, i) => (
                                        <span
                                            class="wave-bar"
                                            style={`--h:${h};--i:${i}`}
                                        />
                                    ))}
                                </span>
                            </span>

                            <span class="row-dur">{formatDuration(t.duration)}</span>
                        </button>
                    </li>
                ))
            }
        </ol>

        <p class="vm-footnote">{copy.footNote}</p>
    </div>

    <div class="vm-player" data-empty="true">
        <div class="pl-top">
            <div class="pl-info">
                <span class="pl-dot" aria-hidden="true"></span>
                <span class="pl-meta">
                    <span class="pl-title" data-pl-title>{copy.playerEmptyTitle}</span>
                    <span class="pl-note" data-pl-note>{copy.playerEmptyNote}</span>
                </span>
            </div>
            <div class="pl-controls">
                <button class="pl-btn" type="button" data-pl-prev aria-label="previous recording">
                    <svg class="ic" viewBox="0 0 24 24"><path d="M7 6h2v12H7zM20 6v12l-9-6z" /></svg>
                </button>
                <button class="pl-btn pl-play" type="button" data-pl-toggle aria-label="play">
                    <svg class="ic ic-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                    <svg class="ic ic-pause" viewBox="0 0 24 24"><path d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
                </button>
                <button class="pl-btn" type="button" data-pl-next aria-label="next recording">
                    <svg class="ic" viewBox="0 0 24 24"><path d="M15 6h2v12h-2zM4 6l9 6-9 6z" /></svg>
                </button>
            </div>
        </div>
        <div class="pl-scrub">
            <span class="pl-time" data-pl-cur>0:00</span>
            <input
                class="pl-range"
                type="range"
                min="0"
                max="1000"
                value="0"
                step="1"
                aria-label="seek within the current recording"
                data-pl-range
            />
            <span class="pl-time" data-pl-dur>0:00</span>
        </div>
    </div>
</section>

<style is:global>
    body {
        background: #000;
        --footer-bg: rgba(6, 6, 8, 0.86);
    }
</style>

<style>
    .vm {
        --rec: #ff453a;
        --rec-soft: rgba(255, 69, 58, 0.16);
        --ink: #f2f2f4;
        --dim: #8b8b93;
        --dim2: #6a6a72;
        --line: rgba(255, 255, 255, 0.08);
        --card: #101014;
        --card-hi: #16161c;
        /* small trans-flag accents, used sparingly */
        --tf-blue: #5bcefa;
        --tf-pink: #f5a9b8;
    }

    .vm {
        position: relative;
        z-index: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100%;
        padding: 20px 16px 0;
        color: var(--ink);
        text-shadow: none;
        font-family: Inter, system-ui, -apple-system, sans-serif;
        text-transform: lowercase;
        letter-spacing: 0.1px;
    }

    /* neutralise the site-wide h*/p hover lift + recolor */
    .vm :where(h1, h2, h3, p):hover {
        color: inherit;
        transform: none;
    }

    .vm-glow {
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
            radial-gradient(120% 60% at 50% 108%, rgba(255, 69, 58, 0.12), transparent 60%),
            radial-gradient(140% 90% at 50% -10%, rgba(255, 255, 255, 0.04), transparent 55%);
    }

    .vm-app {
        width: 100%;
        max-width: 560px;
        padding-bottom: 168px; /* clearance for the sticky player */
    }

    /* ── header ───────────────────────────────────────────── */
    .vm-head {
        padding: 8px 4px 20px;
    }
    .vm-back {
        display: inline-block;
        color: var(--dim);
        text-decoration: none;
        font-size: 0.85rem;
        padding: 4px 2px;
        transition: color 0.15s ease;
    }
    .vm-back:hover {
        color: var(--ink);
    }
    .vm-titlewrap {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 14px;
    }
    .vm-recdot {
        position: relative;
        flex: none;
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: var(--rec);
        box-shadow: 0 0 12px rgba(255, 69, 58, 0.7);
        animation: recPulse 2.4s ease-in-out infinite;
    }
    /* tiny cat ears on the record dot */
    .vm-recdot::before,
    .vm-recdot::after {
        content: '';
        position: absolute;
        top: -4px;
        width: 0;
        height: 0;
        border-left: 3px solid transparent;
        border-right: 3px solid transparent;
        border-bottom: 5px solid var(--rec);
    }
    .vm-recdot::before {
        left: 0px;
        transform: rotate(-18deg);
    }
    .vm-recdot::after {
        right: 0px;
        transform: rotate(18deg);
    }
    .vm-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.3px;
    }
    .vm-sub {
        margin: 8px 0 0 23px;
        color: var(--dim);
        font-size: 0.85rem;
    }

    /* ── pinned share card ────────────────────────────────── */
    .vm-pinned {
        position: relative;
        background: linear-gradient(180deg, var(--card-hi), var(--card));
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px 16px 18px;
        margin-bottom: 22px;
        overflow: hidden;
    }
    .vm-pinned::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: linear-gradient(180deg, var(--tf-blue), var(--tf-pink), #fff);
        opacity: 0.9;
    }
    .vm-pin-tag {
        display: inline-block;
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        color: var(--dim2);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 2px 9px;
    }
    .vm-pin-title {
        margin: 12px 0 0;
        font-size: 1.02rem;
        font-weight: 650;
    }
    .vm-pin-body {
        margin: 6px 0 0;
        color: var(--dim);
        font-size: 0.88rem;
        line-height: 1.45;
    }
    .vm-pin-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 15px;
    }
    .vm-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 11px;
        padding: 11px 16px;
        transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    }
    .vm-link-primary {
        background: var(--rec);
        color: #fff;
        box-shadow: 0 6px 20px rgba(255, 69, 58, 0.28);
    }
    .vm-link-primary:hover {
        transform: translateY(-1px);
        background: #ff5a50;
    }
    .vm-link-icon {
        font-weight: 700;
    }
    .vm-link-ghost {
        color: var(--ink);
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.02);
    }
    .vm-link-ghost:hover {
        border-color: rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.05);
    }

    /* ── memo list ────────────────────────────────────────── */
    .vm-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .vm-item + .vm-item {
        border-top: 1px solid var(--line);
    }

    .row {
        display: grid;
        grid-template-columns: 34px 1fr auto;
        align-items: center;
        gap: 14px;
        width: 100%;
        padding: 13px 10px;
        background: none;
        border: 0;
        border-radius: 12px;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .row:hover {
        background: rgba(255, 255, 255, 0.03);
    }
    .row:focus-visible {
        outline: 2px solid var(--rec);
        outline-offset: -2px;
    }

    .row-lead {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        position: relative;
    }
    .idx-num {
        font-variant-numeric: tabular-nums;
        font-size: 0.82rem;
        color: var(--dim2);
        letter-spacing: 0.02em;
    }
    .idx-play {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        opacity: 0;
    }
    .ic {
        width: 20px;
        height: 20px;
        fill: currentColor;
        display: block;
    }
    .idx-play .ic-pause {
        display: none;
    }
    .row:hover .idx-num,
    .row.is-active .idx-num {
        opacity: 0;
    }
    .row:hover .idx-play,
    .row.is-active .idx-play {
        opacity: 1;
    }
    .row.is-active .row-lead {
        color: var(--rec);
    }
    .row.is-playing .idx-play .ic-play {
        display: none;
    }
    .row.is-playing .idx-play .ic-pause {
        display: block;
    }

    .row-main {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }
    .row-toprow {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
    }
    .row-title {
        font-size: 0.98rem;
        font-weight: 550;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .row.is-active .row-title {
        color: #fff;
    }
    .row-live {
        display: none;
        align-items: center;
        gap: 5px;
        flex: none;
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        color: var(--rec);
    }
    .row.is-active .row-live {
        display: inline-flex;
    }
    .live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--rec);
        animation: recPulse 1.4s ease-in-out infinite;
    }
    .row-note {
        font-size: 0.78rem;
        color: var(--dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .row.is-error .row-note {
        color: var(--rec);
    }

    .wave {
        display: flex;
        align-items: center;
        gap: 2px;
        height: 20px;
        margin-top: 5px;
        opacity: 0.55;
    }
    .wave-bar {
        flex: 1 1 0;
        min-width: 0;
        height: max(2px, calc(var(--h) * 1%));
        background: var(--dim2);
        border-radius: 1px;
        transform-origin: center;
    }
    .row.is-active .wave {
        opacity: 1;
    }
    .row.is-active .wave-bar {
        background: linear-gradient(180deg, #ff6f66, var(--rec));
    }
    .row.is-playing .wave-bar {
        animation: waveGo 1.15s ease-in-out infinite;
        animation-delay: calc(var(--i) * 45ms);
    }

    .row-dur {
        font-variant-numeric: tabular-nums;
        font-size: 0.82rem;
        color: var(--dim2);
        align-self: start;
        padding-top: 2px;
    }
    .row.is-active .row-dur {
        color: var(--dim);
    }

    .vm-footnote {
        margin: 26px 4px 0;
        color: var(--dim2);
        font-size: 0.8rem;
        line-height: 1.5;
    }

    /* ── player strip ─────────────────────────────────────── */
    .vm-player {
        position: sticky;
        bottom: 14px;
        z-index: 2;
        width: 100%;
        max-width: 560px;
        margin: -140px auto 18px;
        background: rgba(20, 20, 24, 0.86);
        -webkit-backdrop-filter: blur(16px) saturate(1.3);
        backdrop-filter: blur(16px) saturate(1.3);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 18px;
        padding: 12px 14px 13px;
        box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55);
    }
    .vm-player[data-empty='true'] .pl-dot {
        background: var(--dim2);
        box-shadow: none;
        animation: none;
    }

    .pl-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .pl-info {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }
    .pl-dot {
        flex: none;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--rec);
        box-shadow: 0 0 10px rgba(255, 69, 58, 0.7);
        animation: recPulse 1.6s ease-in-out infinite;
    }
    .pl-meta {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .pl-title {
        font-size: 0.92rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .pl-note {
        font-size: 0.74rem;
        color: var(--dim);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pl-controls {
        display: flex;
        align-items: center;
        gap: 4px;
        flex: none;
    }
    .pl-btn {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border: 0;
        border-radius: 50%;
        background: none;
        color: var(--ink);
        cursor: pointer;
        transition: background 0.15s ease, transform 0.1s ease;
    }
    .pl-btn:hover {
        background: rgba(255, 255, 255, 0.08);
    }
    .pl-btn:active {
        transform: scale(0.93);
    }
    .pl-btn:focus-visible {
        outline: 2px solid var(--rec);
        outline-offset: 2px;
    }
    .pl-btn .ic {
        width: 22px;
        height: 22px;
    }
    .pl-play {
        width: 46px;
        height: 46px;
        background: var(--rec);
        color: #fff;
    }
    .pl-play:hover {
        background: #ff5a50;
    }
    .pl-play .ic-pause {
        display: none;
    }
    .vm-player.is-playing .pl-play .ic-play {
        display: none;
    }
    .vm-player.is-playing .pl-play .ic-pause {
        display: block;
    }

    .pl-scrub {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 11px;
    }
    .pl-time {
        font-variant-numeric: tabular-nums;
        font-size: 0.72rem;
        color: var(--dim);
        flex: none;
        min-width: 30px;
    }
    .pl-time:last-child {
        text-align: right;
    }

    .pl-range {
        flex: 1 1 auto;
        -webkit-appearance: none;
        appearance: none;
        height: 4px;
        border-radius: 999px;
        background: linear-gradient(
            to right,
            var(--rec) 0%,
            var(--rec) var(--p, 0%),
            rgba(255, 255, 255, 0.16) var(--p, 0%),
            rgba(255, 255, 255, 0.16) 100%
        );
        cursor: pointer;
    }
    .pl-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #fff;
        border: 0;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    }
    .pl-range::-moz-range-thumb {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #fff;
        border: 0;
    }
    .pl-range:focus-visible {
        outline: 2px solid var(--rec);
        outline-offset: 4px;
    }

    /* ── responsive ───────────────────────────────────────── */
    @media (max-width: 420px) {
        .row {
            gap: 10px;
            grid-template-columns: 30px 1fr auto;
            padding: 12px 6px;
        }
        .vm-title {
            font-size: 1.3rem;
        }
        .pl-play {
            width: 44px;
            height: 44px;
        }
    }

    /* ── keyframes + reduced motion ───────────────────────── */
    @keyframes recPulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.35;
        }
    }
    @keyframes waveGo {
        0%,
        100% {
            transform: scaleY(0.45);
        }
        50% {
            transform: scaleY(1);
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .vm-recdot,
        .pl-dot,
        .live-dot {
            animation: none !important;
        }
        .row.is-playing .wave-bar {
            animation: none !important;
        }
        .vm-link-primary:hover,
        .pl-btn:active {
            transform: none;
        }
    }
</style>

<script>
    import { MusicPlayer } from '@/features/music/audio-controller'
    import { tracks } from '@/features/music/singy-songy-data'

    const fmt = (s: number): string => {
        if (!isFinite(s) || s < 0) s = 0
        const m = Math.floor(s / 60)
        const sec = Math.floor(s % 60)
        return `${m}:${sec.toString().padStart(2, '0')}`
    }

    const player = new MusicPlayer(tracks)

    const rows = Array.from(document.querySelectorAll<HTMLButtonElement>('.row[data-track]'))
    const playerEl = document.querySelector<HTMLElement>('.vm-player')
    const plTitle = document.querySelector<HTMLElement>('[data-pl-title]')
    const plNote = document.querySelector<HTMLElement>('[data-pl-note]')
    const plCur = document.querySelector<HTMLElement>('[data-pl-cur]')
    const plDur = document.querySelector<HTMLElement>('[data-pl-dur]')
    const plRange = document.querySelector<HTMLInputElement>('[data-pl-range]')
    const btnToggle = document.querySelector<HTMLButtonElement>('[data-pl-toggle]')
    const btnPrev = document.querySelector<HTMLButtonElement>('[data-pl-prev]')
    const btnNext = document.querySelector<HTMLButtonElement>('[data-pl-next]')

    const emptyTitle = plTitle?.textContent ?? ''
    const emptyNote = plNote?.textContent ?? ''
    let scrubbing = false

    const rowFor = (index: number): HTMLButtonElement | undefined =>
        rows.find((r) => Number(r.dataset.track) === index)

    const setRange = (fraction: number): void => {
        if (!plRange || scrubbing) return
        const clamped = Math.min(Math.max(fraction, 0), 1)
        plRange.value = String(Math.round(clamped * 1000))
        plRange.style.setProperty('--p', `${clamped * 100}%`)
    }

    // row clicks toggle their own track
    for (const row of rows) {
        row.addEventListener('click', () => {
            const i = Number(row.dataset.track)
            player.toggle(i)
        })
    }

    btnToggle?.addEventListener('click', () => player.toggle())
    btnPrev?.addEventListener('click', () => player.prev())
    btnNext?.addEventListener('click', () => player.next())

    if (plRange) {
        const beginScrub = () => {
            scrubbing = true
        }
        const endScrub = () => {
            if (!scrubbing) return
            scrubbing = false
            player.seek(Number(plRange.value) / 1000)
        }
        plRange.addEventListener('pointerdown', beginScrub)
        plRange.addEventListener('keydown', beginScrub)
        plRange.addEventListener('input', () => {
            const frac = Number(plRange.value) / 1000
            plRange.style.setProperty('--p', `${frac * 100}%`)
            const dur = player.current?.duration ?? 0
            if (plCur) plCur.textContent = fmt(frac * dur)
        })
        plRange.addEventListener('change', endScrub)
        plRange.addEventListener('pointerup', endScrub)
        plRange.addEventListener('keyup', endScrub)
    }

    player.on('change', (track) => {
        for (const r of rows) {
            const active = Number(r.dataset.track) === track.index
            r.classList.toggle('is-active', active)
            r.classList.remove('is-error')
            r.setAttribute('aria-label', `${active ? 'pause' : 'play'} ${track.title}`)
        }
        if (plTitle) plTitle.textContent = track.title
        if (plNote) {
            const note = rowFor(track.index)?.querySelector<HTMLElement>('.row-note')
            plNote.textContent = note?.textContent ?? ''
        }
        if (plDur) plDur.textContent = fmt(track.duration)
        if (plCur) plCur.textContent = '0:00'
        playerEl?.removeAttribute('data-empty')
        setRange(0)
    })

    player.on('play', (track) => {
        playerEl?.classList.add('is-playing')
        btnToggle?.setAttribute('aria-label', 'pause')
        for (const r of rows) {
            const isCur = Number(r.dataset.track) === track.index
            r.classList.toggle('is-playing', isCur)
            r.setAttribute('aria-pressed', isCur ? 'true' : 'false')
            if (isCur) r.setAttribute('aria-label', `pause ${track.title}`)
        }
    })

    const clearPlaying = (): void => {
        playerEl?.classList.remove('is-playing')
        btnToggle?.setAttribute('aria-label', 'play')
        for (const r of rows) {
            r.classList.remove('is-playing')
            r.setAttribute('aria-pressed', 'false')
            if (r.classList.contains('is-active')) {
                r.setAttribute('aria-label', `play ${player.current?.title ?? ''}`)
            }
        }
    }

    player.on('pause', clearPlaying)
    player.on('stop', clearPlaying)

    player.on('time', (currentTime, duration, progress) => {
        if (plCur && !scrubbing) plCur.textContent = fmt(currentTime)
        if (plDur && isFinite(duration) && duration > 0) plDur.textContent = fmt(duration)
        setRange(progress)
    })

    player.on('error', (track) => {
        clearPlaying()
        const row = rowFor(track.index)
        if (row) {
            row.classList.add('is-error')
            const note = row.querySelector<HTMLElement>('.row-note')
            if (note) note.textContent = "couldn't load this one, sorry"
        }
        if (plNote) plNote.textContent = "couldn't load this one, sorry"
    })

    // reset the strip to its resting copy if playback ever fully clears
    void emptyTitle
    void emptyNote
</script>
